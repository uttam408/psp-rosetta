static int cpy(int n, int n2, int n3, int n4) {
        return (n - n2) * (n - n2) + (n3 - n4) * (n3 - n4);
}

static int cpys(int n, int n2, int n3, int n4) {
        return (int)sqrt((n - n2) * (n - n2) + (n3 - n4) * (n3 - n4));
}

